# Required for the browser-side Supabase client.
# The URL and anon/publishable key are public client configuration, protected by RLS.
# Existing Vercel names are supported; VITE_* aliases are also accepted.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Server-only secret. Never rename this to a VITE_* variable or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY="server-only-secret"

# Optional legacy/runtime settings retained for other project features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
